{
  "name": "@hytime/dsh-thinking-effort",
  "version": "0.4.0",
  "description": "\u4e3a DSH \u7684 pi-ai \u7b2c\u4e09\u65b9\u6a21\u578b\u8865\u5145\u53ef\u914d\u7f6e\u7684\u601d\u8003\u5f3a\u5ea6\u6863\u4f4d\uff0c\u5e76\u8bbe\u7f6e\u5b50 agent \u9ed8\u8ba4\u601d\u8003\u5f3a\u5ea6\u3002",
  "private": false,
  "engines": {
    "dsh": ">=0.1.7-alpha.1"
  },
  "scripts": {
    "build": "node scripts/check-locales.mjs && tsc -p tsconfig.json && tsdown -c tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:release": "node --test scripts/verify-release.test.mjs scripts/verify-workflows.test.mjs",
    "test:policy": "node --test scripts/pr-policy.test.mjs",
    "test:conventions": "node scripts/check-conventions.mjs",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "homepage": "https://github.com/hytime/dsh-thinking-effort#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/hytime/dsh-thinking-effort.git"
  },
  "bugs": {
    "url": "https://github.com/hytime/dsh-thinking-effort/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.ja.md",
    "README.ko.md",
    "docs/INSTALL.md",
    "docs/INSTALL.zh.md",
    "docs/INSTALL.ja.md",
    "docs/INSTALL.ko.md",
    "docs/SCREENSHOTS.md",
    "docs/CHANGELOG.md",
    "docs/CHANGELOG.ja.md",
    "docs/CHANGELOG.ko.md",
    "docs/assets/",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1 || ^4.0.6-alpha.1",
    "@deepseek-ai/dsh": ">=0.1.7-alpha.1"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "reasoning-effort",
    "thinking",
    "llm-pi-ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-store": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@hytime/dsh-feature-compaction": "workspace:*",
    "@hytime/dsh-feature-levels": "workspace:*",
    "@hytime/dsh-feature-migration": "workspace:*",
    "@hytime/dsh-feature-opencode": "workspace:*",
    "@hytime/dsh-feature-subagent": "workspace:*",
    "@hytime/dsh-plugin-kit": "workspace:*",
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^29.1.1",
    "lightningcss": "1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.7.0"
}
