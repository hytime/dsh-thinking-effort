.superpowers/

# Pre-migration copies of this machine's own settings. They carry apiKey and
# Token fields, so an unignored `git add -A` would publish credentials.
.migration-backup/

# macOS Finder metadata, written into any directory the Finder visits.
.DS_Store

# Stray machine-local tool config the repository does not use: repository CI and
# root dependency installation use npm (`package-lock.json`). The published
# package separately pins pnpm in `packageManager` because DSH profile plugin
# operations run through pnpm. The root pnpm lock/workspace files remain local
# leftovers — the workspace still carries pnpm's placeholder build setting —
# and lefthook.yml is lefthook's commented-out example template.
/pnpm-workspace.yaml
/lefthook.yml
