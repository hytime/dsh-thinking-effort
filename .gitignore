# Pre-migration copies of this machine's own settings. They carry apiKey and
# Token fields, so an unignored `git add -A` would publish credentials.
.migration-backup/

# macOS Finder metadata, written into any directory the Finder visits.
.DS_Store

# Stray machine-local tool config the repository does not use: the official
# toolchain is npm (`package-lock.json`) and nothing here references pnpm or
# lefthook. Both files are unfinished leftovers — the root pnpm-workspace.yaml
# still carries pnpm's `set this to true or false` placeholder, and
# lefthook.yml is lefthook's commented-out example template.
/pnpm-workspace.yaml
/lefthook.yml
